{
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "view", "value": "article" },
        { "type": "query", "key": "id", "value": "4:impressum" }
      ],
      "destination": "/impressum.html",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "view", "value": "article" },
        { "type": "query", "key": "id", "value": "4:impressum" },
        { "type": "query", "key": "catid", "value": "2" }
      ],
      "destination": "/impressum.html",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "view", "value": "article" },
        { "type": "query", "key": "id", "value": "5:datenschutzerklaerung" }
      ],
      "destination": "/datenschutz.html",
      "permanent": true
    },
    {
      "source": "/kontakt",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/ueber-uns",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/hoerproben",
      "destination": "/#hoerproben",
      "permanent": true
    },
    {
      "source": "/medien/downloads",
      "destination": "/downloads.html",
      "permanent": true
    },
    {
      "source": "/medien/:path*",
      "destination": "/downloads.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
